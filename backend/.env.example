# ==============================================================================
# ScholarLink Central & Organization API Environment Configuration Template
# ==============================================================================

# Central Backend Port (Render binds automatically via process.env.PORT)
PORT=5000

# Central Express Environment (development | production)
NODE_ENV=production

# MySQL Database Credentials (Hosted Provider, e.g., Aiven, AWS RDS, DigitalOcean)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_database_password

# Hosted MySQL TLS/SSL Configuration
# Set DB_SSL=true for managed cloud databases requiring encrypted connections.
DB_SSL=false
# Optional CA Certificate (supply path or inline PEM/base64 string if self-signed or custom CA):
# DB_CA_PATH=/etc/ssl/certs/ca.pem
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_REJECT_UNAUTHORIZED=true

# Logical Database / Schema Names
CENTRAL_DB=scholarlink_central
ORG_A_DB=scholarlink_sbi_foundation
ORG_B_DB=scholarlink_tata_capital
ORG_C_DB=scholarlink_reliance_foundation

# Academic Prototype JWT Secret
JWT_SECRET=scholarlink_academic_secret_demo_key_2026

# Organization Microservice Internal Ports (Local Fallbacks)
SBI_API_PORT=5001
TATA_API_PORT=5002
RELIANCE_API_PORT=5003

# Organization Microservice Endpoints (Federation Targets)
# In production on Render, set these to your deployed service URLs:
# e.g., https://scholarlink-sbi.onrender.com
SBI_API_URL=http://localhost:5001
TATA_API_URL=http://localhost:5002
RELIANCE_API_URL=http://localhost:5003

# Permitted Frontend Origin for CORS (e.g., your Vercel deployment URL)
# Multiple origins can be comma-separated
FRONTEND_URL=https://scholarlink.vercel.app

# Federated Lookup Timeout (in milliseconds)
# Set to 30000ms+ to accommodate free-tier Render container cold-start spin-ups
FEDERATION_TIMEOUT_MS=30000
